# Copy to .env.local and fill in. The three endpoints below are REQUIRED —
# the app throws at startup if any is missing, rather than silently falling
# back to the production API the way the current app does.
EXPO_PUBLIC_BASE_SERVICE_URL=
EXPO_PUBLIC_ACCOUNT_MANAGEMENT_URL=
EXPO_PUBLIC_FEDERATED_PROMETHEUS_BASE_URL=

# Required for the rewrite's Firebase email/password auth. Copy the matching
# local values from the gitignored GoogleService-Info.plist. Never commit the
# real API key or plist.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_BUNDLE_ID=com.atlaslabs.horcery.app

# Optional. Only set this deliberately, for a supervised session that needs to
# write against the production backend. Leave unset otherwise.
# EXPO_PUBLIC_ALLOW_PRODUCTION_WRITES=

# Optional, dev builds only. Turns on UI previews that are NOT wired up
# (6-digit reset code flow, tap-to-unlock Face ID gate, Apple/Google
# buttons). These paths are unreachable in release builds regardless of this
# value, but their strings remain in the bundle.
# EXPO_PUBLIC_ENABLE_PREVIEWS=true
